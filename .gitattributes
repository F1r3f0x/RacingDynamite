# Git hook shebangs must survive Windows clones with core.autocrlf enabled.
.githooks/* text eol=lf
.gitattributes text eol=lf
# Verification hashes must see the same input bytes in Windows checkouts and Git.
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.ps1 text eol=lf
